{
  "name": "qbsk",
  "version": "0.1.0",
  "description": "QBSK programming language + ASCII scene engine",
  "private": true,
  "author": "Quebratsk",
  "type": "module",
  "bin": {
    "qbsk": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm --prefix studio run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p studio/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests studio",
    "bench": "node bench/run.mjs",
    "prepack": "npm run build",
    "play": "node dist/cli/main.js run --ansi --loop game/arena.qbsk --fps 60",
    "play:build": "npm run build && node dist/cli/main.js run --ansi --loop game/arena.qbsk --fps 60",
    "studio": "npm --prefix studio run build && npm --prefix studio start",
    "doctor": "node tools/doctor.mjs",
    "build:lang": "tsc -p tsconfig.build.json",
    "postinstall": "npm --prefix studio install"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
