// roadmap_anim.qbsk — the animation surface M17/M18 actually shipped.
//
// The ROADMAP described `hero.animate("x", from: 10, duration: 2s)` and a
// `timeline intro` block form. None of that exists: there are no method calls, named
// arguments are rejected on function calls, `2s` is not a literal, and `timeline` is
// not a keyword (§14.7 removed it from the grammar because it never was one).
//
// What shipped is a native surface, and this file is the executable proof of it.

// --- Tweens (M17) -----------------------------------------------------------
// animate(name, from, to, duration [, easing]) — host-side state keyed by name,
// queried per frame. Easings: linear, ease-in, ease-out, ease-in-out, bounce, elastic.
var x = animate("hero_x", 10.0, 100.0, 2.0, "ease-out")
print("hero_x at t=0: " + str(x))
print("done? " + str(animate_done("hero_x")))

// --- Timelines (M18) --------------------------------------------------------
// A timeline is a VALUE that is queried, not a scheduler that runs.
var intro = timeline_sequence([
    timeline_wait(0.5),
    timeline_step("fade_in", 1.0),
    timeline_parallel([
        timeline_step("slide", 0.8),
        timeline_step("chime", 0.3),
    ]),
])

print("total duration: " + str(timeline_duration(intro)))
print("active at 1.0s: " + str(timeline_active(intro, 1.0)))
print("fade_in at 1.0s: " + str(timeline_progress(intro, "fade_in", 1.0)))

// --- Frame-swapping (M18) ---------------------------------------------------
scene Walk(width: 20, height: 6, title: "M17/M18", fps: 30)

layer bg z: 0
    fill "."

layer walker z: 30
    sprite "res/walk.qba" at (2, 1) frames: 4 fps: 8 loop: true
