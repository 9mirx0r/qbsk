// worldgen_test.qbsk — Phase 27 (entities/history) + Phase 28 (names) + Phase 29
// (action/rules) (the roadmap).
//
// Built with ONLY what QBSK had before these phases: `spawn`/`find`/`without` (Phase
// 22), dicts, `.qbdata` (Phase 23), `on turn`. No new engine primitives were added —
// where one was genuinely needed (a seeded RNG for personality rolls AND for name
// selection), it stayed host-side (bench/worldgen-gen.mjs, bench/worldgen-names-gen.mjs)
// rather than becoming a native, because QBSK has no bitwise operators to write
// mulberry32 as a QBSK-language library. That gap is named, not solved, in both phases'
// decisions.
//
// NPC personalities follow the Dwarf Fortress facet/value model
// (the roadmap §3): facets 0-100 (how an NPC
// acts), values -50..50 (what it believes). Professions follow CDDA's bundled-template
// shape (the roadmap §5). Every name (people,
// places) is generated by the same phoneme system — one shared root-concept pool, a
// per-culture translation table (the roadmap 14-...-research.md §2, Phase 28) — never
// a fixed list. History advances on its own clock (a tick timer drives `advance()`) so
// the whole run is watchable without needing keypresses — a handful of DETERMINISTIC
// rules react to the pre-rolled data, no in-scene randomness needed at all. Turn 3 and
// turn 7's history events are dispatched through lib/action_rules.qbsk's generic
// Action + Rules engine (Phase 29) rather than a bare `if` — see hostilityRule/exileRule
// below and that library's own header for the model (CDDA/Qud audit,
// the roadmap §4.3's "D2: Action/Rules", reopened by name).
scene WorldgenTest(width: 60, height: 24)

use "res/worldgen_npcs.qbdata" as npcdata
use "res/worldgen_locations.qbdata" as locdata
use "res/worldgen_professions.qbdata" as profdata
use "res/worldgen_cultures.qbdata" as culturedata
use "res/worldgen_world.qbdata" as worlddata
use "lib/action_rules.qbsk" as actionrules
use "lib/population.qbsk" as poptable

const LOCATIONS = [locdata.ASHFORD, locdata.MILLBROOK, locdata.CAIRN_HOLLOW]

func locationByName(locKey)
    var i = 0
    while i < len(LOCATIONS)
        if LOCATIONS[i]["key"] == locKey
            return LOCATIONS[i]
        i += 1
    return null

func cultureOf(locKey)
    if locKey == "ashford"
        return culturedata.ASHFORD_CULTURE
    if locKey == "millbrook"
        return culturedata.MILLBROOK_CULTURE
    return culturedata.CAIRN_HOLLOW_CULTURE

func professionOf(name)
    if name == "guard"
        return profdata.GUARD
    if name == "merchant"
        return profdata.MERCHANT
    return profdata.HERMIT

// One dict per NPC, GENERATED by bench/worldgen-gen.mjs from a seed — this list is the
// raw source; spawn() below is what turns each entry into a live, id-bearing entity.
const NPC_SOURCE = [
    npcdata.NPC_0, npcdata.NPC_1, npcdata.NPC_2, npcdata.NPC_3,
    npcdata.NPC_4, npcdata.NPC_5, npcdata.NPC_6, npcdata.NPC_7,
]

var npcs = []
var locations = LOCATIONS
var factions = [
    {"name": "ashford_watch", "hostile_to": []},
    {"name": "wildland_folk", "hostile_to": []},
]
var eventLog = []
var tickAccum = 0.0
var pendingActions = []

func logEvent(msg)
    eventLog = push(eventLog, "t{turn()}: " + msg)

// Phase 31: profession is no longer a fixed string in the source data — it's a raw
// [0,1) roll (bench/worldgen-gen.mjs's profession_roll), resolved HERE against a real
// weighted population table (res/worldgen_professions.qbdata's PROFESSION_TABLE: 50%
// guard, 35% merchant, 15% hermit — a settlement's demographics, not an even split).
func place(src, slot)
    var loc = locationByName(src["location"])
    var profession = poptable.weightedPick(profdata.PROFESSION_TABLE, src["profession_roll"])
    var prof = professionOf(profession)
    return spawn({
        "npc_id": src["id"],
        "name": src["name"],
        "location": src["location"],
        "profession": profession,
        "facets": src["facets"],
        "values": src["values"],
        "glyph": prof["glyph"],
        "x": loc["x"] + (slot * 2),
        "y": loc["y"] + 1,
    })

on start
    var i = 0
    while i < len(NPC_SOURCE)
        npcs = push(npcs, place(NPC_SOURCE[i], i % 3))
        i += 1

func factionByName(name)
    var i = 0
    while i < len(factions)
        if factions[i]["name"] == name
            return factions[i]
        i += 1
    return null

// Average a facet across every live NPC with a given profession — no randomness, the
// "dice" were already rolled once, host-side, at generation time (see the file header).
func avgFacet(profession, facet)
    var total = 0.0
    var count = 0
    var i = 0
    while i < len(npcs)
        var n = npcs[i]
        if n["profession"] == profession
            total += n["facets"][facet]
            count += 1
        i += 1
    if count == 0
        return 0.0
    return total / count

// Deterministic history rules, triggered by turn number against the pre-rolled data —
// this is the whole "small tracked ruleset" from
// the roadmap §1 step 5, minus the randomness DF/CDDA both
// use, because nothing here needed it: every trigger is a threshold check on facets/
// values that were already fixed at generation time.
//
// Turn 3 and turn 7 go through lib/action_rules.qbsk (Phase 29) instead of a bare `if`:
// the turn handler unconditionally proposes an action ("the watch considers declaring
// hostility"; "someone might be exiled"), and the rule decides accept/reject AND, on
// accept, performs the same mutation + logEvent the old inline code did — same
// conditions, same log text, so the scene's behavior (and its golden) is unchanged.
// This is the validation Phase 27/28 both used before it: design against a real scene,
// not a research document. Turn 5 (unconditional founding) and turn 10 (unconditional
// log) aren't rewired — there is no accept/reject decision in either, so wrapping them
// would add a layer without proving anything a rule-less `if` doesn't already show.

func hostilityRule(action, state, pending)
    if action["type"] != "declare_hostile"
        return {"accept": true}
    var cruelty = avgFacet("guard", "cruelty")
    if cruelty <= 60.0
        return {"accept": false}
    // Factions are a small fixed list, never spawn()-ed, so they carry no id for
    // without()/find() (Phase 22's id-based rebuild is for spawned entities). Rebuilt
    // by name instead — the same immutable-list pattern, just keyed differently since
    // there is no id to key on here.
    var nextFactions = []
    var fi = 0
    while fi < len(factions)
        var fac = factions[fi]
        if fac["name"] == "ashford_watch"
            nextFactions = push(nextFactions, {
                "name": "ashford_watch", "hostile_to": ["wildland_folk"],
            })
        else
            nextFactions = push(nextFactions, fac)
        fi += 1
    factions = nextFactions
    var watchHome = locationByName("ashford")
    logEvent(watchHome["name"] + "'s watch (avg cruelty {cruelty}) declares the wildlands hostile.")
    return {"accept": true}

func exileRule(action, state, pending)
    if action["type"] != "exile_least_honest"
        return {"accept": true}
    var i = 0
    var targetName = ""
    var targetId = -1
    var targetHonesty = 0.0
    while i < len(npcs)
        var candidate = npcs[i]
        if candidate["values"]["honesty"] < -20.0 and targetName == ""
            targetName = candidate["name"]
            // without()/find() key on the id spawn() assigned (Phase 22), not on this
            // scene's own "npc_id"/"name" data fields — none of those are it.
            targetId = candidate["id"]
            targetHonesty = candidate["values"]["honesty"]
        i += 1
    if targetName == ""
        return {"accept": false}
    npcs = without(npcs, targetId)
    logEvent(targetName + " (honesty {targetHonesty}) is exiled from the settlement.")
    return {"accept": true}

var historyRules = [hostilityRule, exileRule]

on turn(n)
    if n == 3
        pendingActions = push(pendingActions, {"type": "declare_hostile"})
    if n == 5
        // A brand-new settlement, founded live at turn 5 — unlike the pre-generated
        // NPCs/locations (bench/worldgen-names-gen.mjs), nothing rolls a phoneme name
        // for it here: that would need the same seeded-RNG-in-QBSK gap Phase 27/28 both
        // named and routed around host-side. Founders naming a new place plainly, on
        // the spot, is the honest in-story reading of that same limitation.
        locations = push(locations, {
            "key": "thornwatch", "name": "Thornwatch", "glyph": "T",
            "x": 44, "y": 12, "founded_turn": n,
        })
        logEvent("a new settlement, Thornwatch, is founded.")
    if n == 7
        pendingActions = push(pendingActions, {"type": "exile_least_honest"})
    if n == 10
        logEvent("the recorded history ends.")
    actionrules.process(pendingActions, historyRules, {})
    pendingActions = []

on tick(dt)
    tickAccum += dt
    if tickAccum > 1.2 and turn() < 10
        tickAccum = 0.0
        advance()

layer locations z: 0
    color fg: bright-black
    var i = 0
    while i < len(locations)
        var loc = locations[i]
        put loc["glyph"] at (loc["x"], loc["y"])
        i += 1

layer npcs z: 1
    color fg: white
    var i = 0
    while i < len(npcs)
        var n = npcs[i]
        put n["glyph"] at (n["x"], n["y"])
        i += 1

func settlementLegend()
    var legend = ""
    var i = 0
    while i < len(locations)
        var loc = locations[i]
        legend = legend + loc["glyph"] + "=" + loc["name"] + "  "
        i += 1
    return legend

func cultureLegend()
    var out = ""
    var i = 0
    while i < 3
        var loc = LOCATIONS[i]
        var c = cultureOf(loc["key"])
        out = out + loc["name"] + ": " + c["demonym"] + " of " + c["civilization"] + "  "
        i += 1
    return out

layer hud z: 5
    color fg: bright-yellow
    put worlddata.WORLD["name"] + " | turn {turn()} / 10" at (2, 1)
    color fg: bright-black
    put "settlements: " + settlementLegend() at (2, 2)
    put cultureLegend() at (2, 3)
    put "npcs alive: {len(npcs)}   g=guard m=merchant h=hermit" at (2, 4)
    color fg: white
    var y = 6
    var logStart = 0
    if len(eventLog) > 8
        logStart = len(eventLog) - 8
    var i = logStart
    while i < len(eventLog)
        put eventLog[i] at (2, y)
        y += 1
        i += 1
