// awakening.qbsk — the cold open.
//
// Black. Then two eyes open. They look left, look right. A breath fogs in the
// cold. Black again — and he is awake, and Vosk is at the bars.
//
// The whole cinematic is ONE timeline (Phase 17). Every beat is a named step with
// its own duration, so the pacing lives in one readable block at the top instead
// of being scattered through counters. Nothing here is a frame counter.
//   qbsk run --ansi --loop examples/awakening.qbsk --fps 20
scene Awakening(width: 78, height: 26)

// --- who is who -----------------------------------------------------------
// Each speaker carries their own voice. `pitch` is the beep frequency: Vosk is
// the bigger man and speaks lower. Phase 19 made these real — the tones below
// gate on who is talking, so the conversation beeps in two voices.
const PRISONER = {"name": "Adrian", "tag": "4077", "pitch": 180, "color": "cyan"}
const JAILER = {"name": "Vosk", "tag": "warden", "pitch": 96, "color": "green"}

// --- the cinematic --------------------------------------------------------
const intro = timeline_sequence([
    timeline_step("dark", 1.6),
    timeline_step("open", 1.4),
    timeline_step("left", 1.1),
    timeline_step("right", 1.1),
    timeline_step("breath", 2.4),
    timeline_step("fade", 1.2),
])

// --- the conversation, once the eyes are gone -----------------------------
const script = [
    ["J", "on your feet, 4077."],
    ["P", "...how long was i out?"],
    ["J", "long enough. lights out in ten."],
    ["P", "what day is it, Vosk?"],
    ["J", "does it matter?"],
    ["P", "it did once."],
    ["J", "sleep, Adrian."],
    ["", ""],
]

const talk = timeline_sequence([
    timeline_step("0", 2.6),
    timeline_step("1", 2.4),
    timeline_step("2", 2.8),
    timeline_step("3", 2.6),
    timeline_step("4", 2.2),
    timeline_step("5", 2.4),
    timeline_step("6", 3.0),
    timeline_wait(1.8),
])

var phase = "dark"
var beat = 0
var speaker = ""
var introOver = false

// Eye state, driven by the cinematic beats.
var eyeOpen = 0.0
var eyeGaze = 0.0
var breathY = 0.0
var breathOn = false

// The cell, once he is awake.
var pA = 6.0
var pB = 28.0
var flame = 0
var t = 0

on tick(dt)
    t = t + 1
    flame = int(t / 6) % 3

    var now = gameTime()
    var beats = timeline_active(intro, now)

    if len(beats) > 0
        phase = beats[0]
    else
        phase = "awake"
        introOver = true

    // Each beat sets what the eyes are doing. `timeline_progress` gives the
    // position WITHIN the beat, which is what makes the motion smooth instead
    // of a jump at the boundary.
    if phase == "dark"
        eyeOpen = 0.0
        breathOn = false
    if phase == "open"
        eyeOpen = timeline_progress(intro, "open", now)
        eyeGaze = 0.0
    if phase == "left"
        eyeOpen = 1.0
        eyeGaze = 0.0 - timeline_progress(intro, "left", now)
    if phase == "right"
        eyeOpen = 1.0
        eyeGaze = timeline_progress(intro, "right", now) * 2.0 - 1.0
    if phase == "breath"
        eyeOpen = 1.0
        eyeGaze = 0.0
        breathOn = true
        breathY = timeline_progress(intro, "breath", now)
    if phase == "fade"
        eyeOpen = 1.0 - timeline_progress(intro, "fade", now)
        breathOn = false

    if introOver
        var speaking = timeline_active(talk, gameTime() % timeline_duration(talk))
        if len(speaking) > 0
            beat = int(speaking[0])
        else
            beat = 7
        speaker = script[beat][0]

        if animate_done("pace")
            var pt = pA
            pA = pB
            pB = pt

// --- the dark ---------------------------------------------------------------

layer void z: 0
    color bg: black fg: black
    fill " "

// --- the eyes ---------------------------------------------------------------
// Two lids that part. `eyeOpen` decides which lid glyph shows, `eyeGaze` slides
// the pupil, so the same three lines cover open, look and close.

// NOTE: `visible:` is a STATE DIRECTIVE, not a layer-level guard — it gates every
// primitive BELOW it in the layer until another `visible:` replaces it (language.md
// §7.1b). One directive covers a whole group of puts; rewriting it changes the
// condition for what follows. A `visible:` at the END of the layer reaches nothing
// and `qbsk check` reports it. This is the form documented in §7.8(c).
layer eyes z: 2
    color fg: bright-black
    visible: eyeOpen > 0.05
    put "_______" at (32, 11)
    put "_______" at (42, 11)
    color fg: bright-white
    visible: eyeOpen > 0.35
    put "(     )" at (32, 12)
    put "(     )" at (42, 12)
    color fg: bright-cyan
    visible: eyeOpen > 0.6
    put "o" at (35 + round(eyeGaze * 2.0), 12)
    put "o" at (45 + round(eyeGaze * 2.0), 12)
    color fg: bright-black
    visible: eyeOpen > 0.35
    put "~~~~~~~" at (32, 13)
    put "~~~~~~~" at (42, 13)

// --- the breath -------------------------------------------------------------
// Vapour drifts UP and thins out: four glyphs at four heights, each appearing only
// for its slice of the beat. It rises from BELOW the eyes and stops short of them —
// it comes from his mouth, and drifting across his own face read as noise.

layer breath z: 3
    color fg: bright-white
    visible: breathOn and breathY > 0.15
    put "o" at (39, 18)
    color fg: bright-black
    visible: breathOn and breathY > 0.40
    put ".o." at (38, 17)
    visible: breathOn and breathY > 0.65
    put ". : ." at (37, 16)
    visible: breathOn and breathY > 0.85
    put ".  .  ." at (36, 15)

// --- the cell, after the eyes close ----------------------------------------

layer cell z: 1
    visible: introOver
    color fg: bright-black
    border (2, 2) to (34, 20) style: single
    put "  D BLOCK - CELL 04  " at (8, 2)
    put "+======+" at (5, 4)
    put "| # # #|" at (5, 5)
    put "+======+" at (5, 6)
    color fg: bright-white
    put "( )" at (24, 4)
    color fg: bright-black
    put "+--------+" at (4, 15)
    put "|________|" at (4, 16)

layer bars z: 3
    visible: introOver
    color fg: bright-white
    put "#" at (34, 8)
    put "#" at (34, 9)
    put "#" at (34, 10)
    put "#" at (34, 11)
    put "#" at (34, 12)
    put "#" at (34, 13)
    put "#" at (34, 14)
    put "#" at (34, 15)
    put "#" at (34, 16)
    put "#" at (34, 17)
    put "#" at (34, 18)
    put "#" at (34, 19)
    color fg: yellow
    put "=o" at (34, 13)

layer torch z: 3
    visible: introOver
    color fg: bright-black
    put "|" at (70, 7)
    color fg: yellow
    put "Y" at (70, 6)
    color fg: bright-yellow
    visible: introOver and flame == 0
    put "*" at (70, 5)
    visible: introOver and flame == 1
    put "^" at (70, 5)
    color fg: bright-red
    visible: introOver and flame == 2
    put "'" at (70, 5)

layer figures z: 4
    visible: introOver
    color fg: bright-cyan
    sprite "res/walk.qba" at (round(animate("pace", pA, pB, 7.0, "ease-in-out")), 17) frames: 4 fps: 6 loop: true
    color fg: bright-green
    put "[o]" at (44, 16)
    put "/|\\" at (44, 17)
    put "/ \\" at (44, 18)
    color fg: yellow
    put "!" at (48, 17)

// --- the text window --------------------------------------------------------
// A proper frame with a name plate, not a bare line of text: double rule, the
// speaker's name inset in their own colour, and the line indented under it.

layer textframe z: 5
    visible: introOver
    color fg: bright-black
    put "+--------------------------------------------------------------------------+" at (1, 21)
    put "|                                                                          |" at (1, 22)
    put "|                                                                          |" at (1, 23)
    put "|                                                                          |" at (1, 24)
    put "+--------------------------------------------------------------------------+" at (1, 25)

// Each speaker's beep. Gated on who is talking, so a tone is ABSENT from the plan
// while the other speaks — and an absent tone forgets its record, which is what
// makes it fire again on the next line rather than staying silent (docs/audio.md §5).
layer voice z: 6
    visible: introOver and speaker == "P"
    tone 180 wave: triangle duration: 0.09 volume: 0.35
    visible: introOver and speaker == "J"
    tone 96 wave: square duration: 0.12 volume: 0.4

layer nameplate z: 6
    visible: introOver and speaker == "P"
    color fg: bright-cyan
    put "[ {PRISONER["name"]} - {PRISONER["tag"]} ]" at (4, 21)
    color fg: bright-white
    put "{script[beat][1]}" at (6, 23)

    visible: introOver and speaker == "J"
    color fg: bright-green
    put "[ {JAILER["name"]} - {JAILER["tag"]} ]" at (4, 21)
    color fg: bright-white
    put "{script[beat][1]}" at (6, 23)
