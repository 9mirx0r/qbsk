// Orientation glyphs (docs/engine.md §11.16).
//
// The same figure twice. On the left, `line` draws the character it has always drawn:
// one glyph everywhere, so an edge's direction is something you infer from the shape.
// On the right, `style: stroke` picks the glyph from the line's own direction.
//
// The roof is the case worth reading. It rises six cells over twelve — which is 45
// degrees ON SCREEN, because a cell is one wide and two tall — and it comes back
// diagonal only because the angle is aspect-corrected before the glyph is chosen. The
// eave below it rises one cell over twenty and stays horizontal, which is the other
// half of the same rule.

scene Orientation(width: 62, height: 15, title: "which way the ink runs")

layer flat z: 0
    color fg: bright-black
    put "density only" at (2, 0)
    line (2, 8) to (14, 2)
    line (14, 2) to (26, 8)
    line (2, 8) to (2, 12)
    line (26, 8) to (26, 12)
    line (2, 12) to (26, 12)
    line (3, 14) to (25, 13)

layer oriented z: 0
    color fg: bright-cyan
    put "+ orientation" at (33, 0)
    line (33, 8) to (45, 2) style: stroke
    line (45, 2) to (57, 8) style: stroke
    line (33, 8) to (33, 12) style: stroke
    line (57, 8) to (57, 12) style: stroke
    line (33, 12) to (57, 12) style: stroke
    line (34, 14) to (56, 13) style: stroke
